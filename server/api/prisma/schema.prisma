generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  ADMIN
  PASSENGER
  DRIVER
}

enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
  BLOCKED
  DEACTIVATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DriverRequestStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum VehicleStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TripStatus {
  DRAFT
  PUBLISHED
  AVAILABLE
  FULL
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BookingStatus {
  PENDING
  PENDING_PAYMENT
  AWAITING_CONFIRMATION
  CONFIRMED
  REJECTED
  CANCELLED
  IN_TRIP
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum NotificationType {
  SYSTEM
  BOOKING
  PAYMENT
  TRIP
  CHAT
  REMINDER
}

enum RatingTarget {
  DRIVER
  PASSENGER
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum ReportTarget {
  DRIVER
  PASSENGER
}

enum DriverDocumentType {
  ID_CARD
  DRIVER_LICENSE
  SELFIE
  PROFILE_PHOTO
  POLICE_RECORD
  MEDICAL_CERTIFICATE
}


enum DriverStatus {
  ONLINE
  OFFLINE
  SUSPENDED
  INACTIVE
}



model User {
  id          String      @id @default(uuid())
  phone       String      @unique
  role        Role        @default(PASSENGER)
  status      UserStatus  @default(PENDING)
  fullName        String
  gender          Gender
  birthDate       DateTime
  photoUrl        String?
  emergencyPhone  String?
  driver      DriverProfile?
  bookings    Booking[]
  notifications Notification[]
  otpCodes    OTPCode[]
  messages Message[]
  complaint Complaint[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  givenRatings    Rating[] @relation("GivenRatings")
  receivedRatings Rating[] @relation("ReceivedRatings")
  reportsMade     UserReport[] @relation("Reporter")
  reportsReceived UserReport[] @relation("Reported")
}

model DriverProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestStatus     DriverRequestStatus @default(PENDING)
  rejectionReason   String?
  approvedAt        DateTime?
  approvedBy        String?
  licenseCategory   String?
  identityNumber    String? @unique
  licenseNumber     String @unique
  licenseExpiry     DateTime?
  status            DriverStatus @default(OFFLINE)
  vehicles          Vehicle[]
  documents         DriverDocument[]
  trips             Trip[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model DriverDocument {
  id          String @id @default(uuid())
  driverId    String
  driver      DriverProfile @relation(fields:[driverId],references:[id],onDelete:Cascade)
  type        DriverDocumentType
  fileUrl     String
  verified    Boolean @default(false)
  verifiedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  @@unique([driverId,type])
}

model Vehicle {
  id                  String   @id @default(uuid())
  driverId            String
  name        String
  capacity    Int
  description String?
  driver              DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleTypeId       String
  brand               String
  model               String
  year                Int
  color               String
  plateNumber         String   @unique
  totalSeats          Int
  passengerSeats      Int
  status              VehicleStatus @default(PENDING)
  rejectionReason     String?
  documents           VehicleDocument[]
  trips               Trip[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model VehicleDocument {
  id          String   @id @default(uuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type        String
  fileUrl     String
  verified    Boolean @default(false)
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  @@unique([vehicleId,type])
}


model Location {
  id          String   @id @default(uuid())
  name        String
  latitude    Float
  longitude   Float
  description String?
  accuracy    Float?
  formattedAddress String?
  externalId String?
  street      String
  neighborhood String
  city        String
  province    String
  country     String @default("Angola")
  tripOrigins Trip[] @relation("TripOrigin")
  tripDestinations Trip[] @relation("TripDestination")
  tripStops TripStop[]
  createdAt DateTime @default(now())
  @@index([latitude, longitude])
  @@index([city])
  @@index([neighborhood])
}


model Trip {
  id String @id @default(uuid())
  driverId String
  driver DriverProfile @relation(fields:[driverId],references:[id])
  vehicleId String
  vehicle Vehicle @relation(fields:[vehicleId],references:[id])
  name String?
  originId String
  origin Location @relation("TripOrigin",fields:[originId],references:[id])
  destinationId String
  destination Location @relation("TripDestination",fields:[destinationId],references:[id])
  distanceKm Float?
  estimatedMinutes Int?
  departureDate DateTime
  publishedSeats Int
  priceBase Decimal @db.Decimal(10,2)
  status TripStatus @default(DRAFT)
  stops TripStop[]
  bookings Booking[]
  locations DriverLocation[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([departureDate,status])
  
}

enum StopType {
  PICK
  DROP
}

model TripStop {
  id String @id @default(uuid())
  tripId String
  bookingId String
  booking Booking @relation(fields: [bookingId] , references: [id] , onDelete:Cascade)
  trip Trip @relation(fields:[tripId],references:[id],onDelete:Cascade)
  locationId String
  location Location @relation(fields:[locationId],references:[id])
  order Int
  type StopType 
  distanceFromStart Float?
  createdAt DateTime @default(now())
  @@unique([tripId,order])
}

model Booking {
  id              String   @id @default(uuid())
  tripId          String
  trip            Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  passengerId     String
  passenger       User     @relation(fields: [passengerId], references: [id])
  seats           Int      @default(1)
  price           Decimal  @db.Decimal(10,2)
  status          BookingStatus @default(PENDING)
  payment         Payment?
  chat            Conversation?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  rating Rating[]
  complaint Complaint[]
  userReport UserReport[]
  tripStop TripStop[]
  @@index([tripId, status])
}

model Payment {
  id              String   @id @default(uuid())
  bookingId       String   @unique
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount          Decimal  @db.Decimal(10,2)
  method          String
  transactionId   String?
  status          PaymentStatus @default(PENDING)
  paidAt          DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DriverLocation {
  id          String   @id @default(uuid())
  tripId      String
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  latitude    Float
  longitude   Float
  heading     Float?
  speed       Float?
  createdAt   DateTime @default(now())
  @@index([tripId, createdAt])
}


model Conversation {
  id          String   @id @default(uuid())
  bookingId   String   @unique
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  messages    Message[]
  createdAt   DateTime @default(now())
}

model Message {
  id              String   @id @default(uuid())
  conversationId  String
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId        String
  sender          User     @relation(fields: [senderId], references: [id])
  content         String
  status          MessageStatus @default(SENT)
  createdAt       DateTime @default(now())
}

model OTPCode {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code        String
  expiresAt   DateTime
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        NotificationType
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
}


model Rating {
  id              String   @id @default(uuid())
  bookingId       String
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromUserId      String
  fromUser        User     @relation("GivenRatings", fields: [fromUserId], references: [id])
  toUserId        String
  toUser          User     @relation("ReceivedRatings", fields: [toUserId], references: [id])
  target          RatingTarget
  stars           Int
  comment         String?
  createdAt       DateTime @default(now())
  @@unique([bookingId, fromUserId])
}

model Complaint {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  bookingId       String?
  booking         Booking? @relation(fields: [bookingId], references: [id])
  category        String
  description     String
  status          ComplaintStatus @default(OPEN)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UserReport {
  id              String   @id @default(uuid())
  reporterId      String
  reporter        User     @relation("Reporter", fields: [reporterId], references: [id])
  reportedUserId  String
  reportedUser    User     @relation("Reported", fields: [reportedUserId], references: [id])
  bookingId       String?
  booking         Booking? @relation(fields: [bookingId], references: [id])
  target          ReportTarget
  reason          String
  createdAt       DateTime @default(now())
}